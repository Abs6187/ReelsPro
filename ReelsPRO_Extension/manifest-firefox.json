{
    "manifest_version": 3,
    "name": "ReelsPRO",
    "description": "Protect your privacy and uphold values by auto detecting & blurring images and videos of unwanted or impermissible content.",
    "version": "0.2.7",
    "permissions": ["storage", "contextMenus"],
    "host_permissions": ["https://*/*", "http://*/*"],
    "author": "contact2abhaygupta@gmail.com",
    "homepage_url": "https://github.com/Abs6187/ReelsPRO",
    "action": {
        "default_title": "ReelsPRO",
        "default_popup": "src/popup.html"
    },
    "background": {
        "scripts": ["src/background-firefox.js"],
        "type": "module"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "reelspro@reelspro.extension",
            "strict_min_version": "109.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "icons": {
        "16": "src/assets/rp-icon-48.png",
        "48": "src/assets/rp-icon-48.png",
        "128": "src/assets/rp-icon-128.png"
    },
    "content_scripts": [
        {
            "js": ["dist/content.js"],
            "matches": ["https://*/*", "http://*/*"],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["src/assets/*", "tfjs/*"],
            "matches": ["https://*/*", "http://*/*"]
        }
    ]
}
